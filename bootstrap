#!/usr/bin/env bash

# https://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# set options
#       -e                              : Exit immediately if a command exits with non-zero status
#       -u                              : Treat unset variables as errors when substituting
#       -o pipefail                     : Pipeline fails if any command fails, not just the last one
set -euo pipefail

# Assign LIB_COMMON to a common library, and source it
LIB_COMMON="$(dirname -- "${BASH_SOURCE[0]}")/lib/common.sh"
source "$LIB_COMMON" || {
    echo "ERROR: Failed to source $LIB_COMMON" >&2
    exit 1
}

# Set argument to an empty string, since nounset (-u) is enabled
OPTION="${1:-}"

case "${OPTION}" in
    -a | --all)
        pkg::sync_refresh_upgrade
        install::system
        install::nvim
        cfg::deploy
        ;;
    -s | --system)
        pkg::sync_refresh_upgrade
        install::system
        cfg::deploy
        ;;
    --nvim)
        install::nvim
        ;;
    -c | --configs)
        cfg::deploy
        ;;
    -h | --help)
        echo "Usage: ./bootstrap [option]"
        echo "      -a, --all           Install everything"
        echo "      -s, --system        Install system dependencies"
        echo "      -c, --configs       Deploy configs"
        echo "      --nvim              Bootstrap Neovim"
        ;;
    *)
        echo "Invalid option. See --help."
        exit 1
        ;;
esac
