#!/usr/bin/env bash

# set options
#       -e                              : Exit immediately if a command exists with non-zero status
#       -u                              : Treat unset variables as errors when substituting
#       -o pipefail                     : Pipeline fails if any command fails, not just the last one
set -euo pipefail

source "./lib/common.sh" || echo "ERROR: Failed to source ./lib/common.sh"

# Set argument to an empty string, since nounset (-u) is enabled
OPTION="${1:-}"

case "${OPTION}" in
    -a | --all)
        force_sync_refresh_upgrade
        bootstrap_system
        bootstrap_nvim
        link_configs
        ;;
    -s | --system)
        force_sync_refresh_upgrade
        bootstrap_system
        ;;
    --nvim)
        force_sync_refresh_upgrade
        bootstrap_nvim
        ;;
    -c | --configs)
        link_configs
        ;;
    -h | --help)
        echo "Usage: ./bootstrap [option]"
        echo "      -a, --all           Install everything"
        echo "      -s, --system        Install system dependencies"
        echo "      -c, --configs       Install configs"
        echo "      --nvim              Bootstrap Neovim"
        ;;
    *)
        echo "Invalid option. See --help."
        exit 1
        ;;
esac
