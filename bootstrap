#!/usr/bin/env bash

# https://www.gnu.org/software/bash/manual/bash.html#The-Set-Builtin
# set options
#       -e                              : Exit immediately if a command exits with non-zero status
#       -u                              : Treat unset variables as errors when substituting
#       -o pipefail                     : Pipeline fails if any command fails, not just the last one
set -euo pipefail

# Assign LIB_COMMON to a common library, and source it
LIB_COMMON="$(dirname -- "${BASH_SOURCE[0]}")/lib/common.sh"
# shellcheck source=lib/common.sh
source "$LIB_COMMON" || {
    echo "ERROR: Failed to source $LIB_COMMON" >&2
    exit 1
}

# Set argument to an empty string, since nounset (-u) is enabled
OPTION="${1:-}"

# Which platform modules this machine gets?
# Modules themselves never check for WSL
platform::provision() {
    if wsl::is_wsl; then
        wsl::provision
    else
        host::provision
        desktop::provision
    fi
}

platform::deploy() {
    if wsl::is_wsl; then
        wsl::deploy
    else
        host::deploy
        desktop::deploy
    fi
}

confirm() {
    local response
    read -rp "$1 [Y/n] " response
    # test -z option catches empty response (just pressing Enter)
    [[ -z "$response" || "${response,,}" == y || "${response,,}" == yes ]]
}

# Services only exist on bare metal
maybe_enable_services() {
    if ! wsl::is_wsl && confirm "Enable services?"; then
        host::enable_services
    fi
}

log::info "Bootstrapping with $OPTION option"
run::is_dry && log::dry "Nothing will be changed"

case "$OPTION" in
    -u | --userland)
        pkg::sync_refresh_upgrade
        base::provision
        platform::provision
        base::deploy
        platform::deploy
        maybe_enable_services
        ;;
    -a | --all)
        pkg::sync_refresh_upgrade
        base::provision
        nvim::provision
        platform::provision
        base::deploy
        nvim::deploy
        platform::deploy
        maybe_enable_services
        ;;
    --nvim)
        nvim::provision
        nvim::deploy
        ;;
    -d | --desktop)
        desktop::provision
        desktop::deploy
        ;;
    --host)
        host::provision
        host::deploy
        ;;
    -c | --configs)
        base::deploy
        nvim::deploy
        platform::deploy
        ;;
    -h | --help)
        cat <<'EOF'
Usage: ./bootstrap <option>
      -u, --userland      Base userland + platform (desktop & host, or WSL)
      -a, --all           Everything: userland + Neovim
      --nvim              Neovim only (packages + config)
      -d, --desktop       Niri desktop only (packages + configs)
      --host              Host-specific system config only (/etc, needs sudo)
      -c, --configs       Deploy all configs, no installs

Environment:
      DRY_RUN=1           Print what would change, change nothing
EOF
        ;;
    *)
        log::error "Invalid option. See --help."
        exit 1
        ;;
esac
